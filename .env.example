OTA_USERNAME=
OTA_PASSWORD=
OTA_P12_PATH=/absolute/path/to/uOTAServer.p12
OTA_P12_PASSWORD=
# Optional: platform root CA PEM. If unset, explicitly trust the certificate in the P12.
OTA_CA_FILE=
OTA_CONSOLE_URL=https://nota.urovo.com:7003/UpdateConsole/
OTA_UPDATE_URL=https://nota.urovo.com:7000/Update/osUpdate
OTA_TIMEOUT=60
OTA_UPLOAD_TIMEOUT=1800
OTA_LOG_DIR=./logs
OTA_STATE_DIR=./data
# Generate using: uv run ota token
OTA_API_TOKEN=
OTA_MAX_UPLOAD_BYTES=4294967296
# MCP: use bundled reviewed profiles when unset; custom catalog must contain reviewed requirements.
OTA_CATALOG_FILE=
OTA_PACKAGE_DIR=./data/packages
OTA_PLAN_TTL=600
